-- 13.Q: Display employees with a salary category:
-- High (≥80,000)
-- Medium (50,000–79,999)
-- Low (<50,000)
SELECT Name,
       Salary,
       CASE
           WHEN Salary >= 80000 THEN 'High'
           WHEN Salary >= 50000 THEN 'Medium'
           ELSE 'Low'
       END AS SalaryCategory
FROM Employees;



















